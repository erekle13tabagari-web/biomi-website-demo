# ============================================================
#  Biomi website — ignore source / working material.
#  The deployed site is only: *.html, assets/, fonts/, launch.html
# ============================================================

# Raw product / brand source folders (images already live in assets/)
/concrete product page/
/stock images/
/partner logoes/
/New brandbook and materials/
/Pictograms/
/svg/

# Old snapshots
/backup - rebrand v1 (before design polish)/
/backup - rebrand v2 (design polish)/

# Brand documents / source PDFs (not served by the site)
*.pdf
!assets/downloads/*.pdf

# Saved-webpage dumps (can embed third-party API keys)
*_files/
*.download

# Local dev tooling
/.claude/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini

# Design reference images (source material)
/referances/

# Local publish button
*.bat

# Futura source cuts — the site only serves the two Upright variable files,
# which are committed. Static OTFs and the oblique cuts stay local (~10 MB).
/fonts/Futura 100/OTF/
/fonts/Futura 100 Georgian/OTF/
/fonts/Futura 100/Variable/*Oblique*
/fonts/Futura 100 Georgian/Variable/*Oblique*
